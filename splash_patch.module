#!name=Local splash-ad patch
#!desc=Five previously tested rules for Zhibo8, Hupu and ad SDK endpoints.

[Rule]
URL-REGEX,^http://[^/]+:8091/allOne\.php\?(?:[^&]*&)*ad_name=main_splash_ios(&|$),REJECT
DOMAIN,goblin.hupu.com,REJECT
DOMAIN,api-access.pangolin-sdk-toutiao.com,REJECT
DOMAIN,api-access.pangolin-sdk-toutiao1.com,REJECT
DOMAIN,api-access.pangolin-sdk-toutiao-b.com,REJECT

# Additional source-backed ad domains; not yet tested on this device.
# Source: https://github.com/TG-Twilight/AWAvenue-Ads-Rule/blob/main/AWAvenue-Ads-Rule.txt

# Tencent Video / GDT ad assets
DOMAIN,adsmind.gdtimg.com,REJECT
DOMAIN,pgdt.gtimg.cn,REJECT

# QQ Music ad endpoints
DOMAIN,ad.tencentmusic.com,REJECT
DOMAIN,adcdn.tencentmusic.com,REJECT
DOMAIN,tmead.y.qq.com,REJECT
DOMAIN,tmeadcomm.y.qq.com,REJECT

# 360 Smart Life ad endpoint
DOMAIN,ad.iot.360.cn,REJECT

# Narrow Zhibo8 ad placements; device validation pending.
URL-REGEX,^http://[^/]+:8091/allOne\.php\?(?:[^&#]*&)*ad_name=(?:main_popup_ios|main_important_ios|main_inter|main_match)(?:&|$),REJECT

# Additional Tencent GDT ad asset hosts.
# Source: https://github.com/TG-Twilight/AWAvenue-Ads-Rule/blob/main/AWAvenue-Ads-Rule.txt
DOMAIN,adsmind.ugdtimg.com,REJECT
DOMAIN,pgdt.ugdtimg.com,REJECT

# Additional GDT interactive-ad endpoints; device validation pending.
# Source: https://github.com/TG-Twilight/AWAvenue-Ads-Rule/blob/main/AWAvenue-Ads-Rule.txt
DOMAIN,canvas-cdn.gdt.qq.com,REJECT
DOMAIN,v3.gdt.qq.com,REJECT

# Douban ad hosts; device validation pending.
# Sources: https://github.com/vokins/ad/blob/main/ad.lsr
# https://github.com/xinggsf/Adblock-Plus-Rule/blob/master/rule.txt
DOMAIN,erebor.douban.com,REJECT
DOMAIN,at3.doubanio.com,REJECT
